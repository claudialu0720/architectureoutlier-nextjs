# SQLite database file path
# Dev: ./data/data.db (gitignored)
# Prod: /var/lib/careertest/data.db
DATABASE_PATH=/var/lib/careertest/data.db

# Admin credentials
# Generate hash with: npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Session signing secret (32+ random bytes)
# Generate with: openssl rand -base64 32
SESSION_SECRET=NAS1KI7ebd8ydgsfBs64SbSk23HChTdvcKvalZzQRD8=

# Public root URL or /test URL where the app is reachable (used in emails/admin links)
PUBLIC_BASE_URL=https://architectureoutlier.com

# Email (Resend) — leave RESEND_API_KEY blank in dev to log instead of send
RESEND_API_KEY=
EMAIL_FROM="Architect Career Test <noreply@test.architectureoutlier.com>"
NEXT_PUBLIC_DEFAULT_LANG=en